rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // يرفع كل مستخدم ملفاته داخل مجلده فقط.
    // القراءة عبر رابط التنزيل ذي الرمز المخزن داخل رسالة المحادثة الخاصة.
    match /chatMedia/{chatId}/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource != null
                   && request.resource.size <= 20 * 1024 * 1024
                   && request.resource.contentType != null;
      // يمنع القراءة المباشرة من Storage SDK لغير صاحب الملف.
      // الطرف الآخر يستخدم downloadURL ذي الرمز الذي لا يظهر إلا داخل رسالة يقرأها أعضاء المحادثة.
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
