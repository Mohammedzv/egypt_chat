{
  "rules": {
    ".read": false,
    ".write": false,
    "usernameIndex": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.isString() && newData.val() == auth.uid) || (data.val() == auth.uid && !newData.exists()))"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name', 'username']) && newData.child('name').isString() && newData.child('username').isString()"
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$chatId": {
          ".write": "auth != null && newData.val() == true && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true && root.child('chats').child($chatId).child('members').child($uid).val() == true"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() == true",
        ".write": "auth != null && ((!data.exists() && newData.child('members').child(auth.uid).val() == true) || data.child('members').child(auth.uid).val() == true)",
        ".validate": "newData.hasChildren(['type', 'members', 'createdAt'])"
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true",
        "$messageId": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true && !data.exists() && newData.child('sender').val() == auth.uid",
          ".validate": "newData.hasChildren(['sender', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 4000"
        }
      }
    }
  }
}
